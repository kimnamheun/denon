// 치과 임플란트 중계 플랫폼 - Prisma Schema
// Spring Boot + JPA + MariaDB → Next.js + Prisma + PostgreSQL 마이그레이션
// 기존 dental-backend 의 14개 도메인 엔티티를 1:1 매핑

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// Enums
// ============================================================

enum UserRole {
  PATIENT
  DENTIST
  ADMIN
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum Urgency {
  LOW
  MEDIUM
  HIGH
}

enum QuotationRequestStatus {
  OPEN
  IN_PROGRESS
  CLOSED
  EXPIRED
}

enum QuotationStatus {
  DRAFT
  PENDING
  ACCEPTED
  REJECTED
  EXPIRED
  WITHDRAWN
}

enum ConsultationStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum PriceRange {
  LOW
  MEDIUM
  HIGH
  PREMIUM
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum HospitalType {
  CLINIC
  HOSPITAL
  UNIVERSITY
}

// ============================================================
// Auth.js (next-auth v5) 모델
// PrismaAdapter 요구사항 — User 와 1:N
// ============================================================

model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ============================================================
// 도메인 모델
// ============================================================

model User {
  id            String     @id @default(cuid())
  email         String     @unique
  password      String? // OAuth 사용자는 null
  name          String     @db.VarChar(100)
  phoneNumber   String?    @unique @map("phone_number") @db.VarChar(20)
  role          UserRole
  status        UserStatus @default(ACTIVE)
  emailVerified DateTime?  @map("email_verified")
  image         String?

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  patient                Patient?
  dentist                Dentist?
  accounts               Account[]
  sessions               Session[]
  quotationStatusChanges QuotationStatusHistory[]

  @@index([email])
  @@index([role])
  @@map("users")
}

model Patient {
  id            String    @id // User 와 1:1 shared PK
  birthDate     DateTime? @map("birth_date") @db.Date
  gender        Gender?
  sido          String?   @db.VarChar(50)
  sigungu       String?   @db.VarChar(50)
  dong          String?   @db.VarChar(50)
  detailAddress String?   @map("detail_address")
  zipCode       String?   @map("zip_code") @db.VarChar(10)
  latitude      Decimal?  @db.Decimal(10, 8)
  longitude     Decimal?  @db.Decimal(11, 8)
  hasInsurance  Boolean   @default(false) @map("has_insurance")
  insuranceType String?   @map("insurance_type") @db.VarChar(50)

  user              User               @relation(fields: [id], references: [id], onDelete: Cascade)
  quotationRequests QuotationRequest[]
  consultations     Consultation[]
  reviews           Review[]
  chatRooms         ChatRoom[]

  @@map("patients")
}

model Dentist {
  id                String  @id // User 와 1:1 shared PK
  clinicId          String? @map("clinic_id")
  licenseNumber     String  @unique @map("license_number") @db.VarChar(50)
  specialization    String  @db.VarChar(100)
  yearsOfExperience Int?    @map("years_of_experience")
  education         String?
  introduction      String? @db.Text
  isVerified        Boolean @default(false) @map("is_verified")

  user             User                 @relation(fields: [id], references: [id], onDelete: Cascade)
  clinic           Clinic?              @relation(fields: [clinicId], references: [id])
  quotations       Quotation[]
  consultations    Consultation[]
  reviews          Review[]
  chatRooms        ChatRoom[]
  lessonProgresses LessonProgress[]
  credentials      DentistCredential[]
  subscription     DentistSubscription?

  @@map("dentists")
}

model Clinic {
  id             String      @id @default(cuid())
  name           String
  businessNumber String      @unique @map("business_number") @db.VarChar(20)
  phoneNumber    String?     @map("phone_number") @db.VarChar(20)
  description    String?     @db.Text
  sido           String?     @db.VarChar(50)
  sigungu        String?     @db.VarChar(50)
  dong           String?     @db.VarChar(50)
  detailAddress  String?     @map("detail_address")
  zipCode        String?     @map("zip_code") @db.VarChar(10)
  latitude       Decimal?    @db.Decimal(10, 8)
  longitude      Decimal?    @db.Decimal(11, 8)
  rating         Decimal     @default(0) @db.Decimal(2, 1)
  reviewCount    Int         @default(0) @map("review_count")
  isPremium      Boolean     @default(false) @map("is_premium")
  hasParking     Boolean     @default(false) @map("has_parking")
  priceRange     PriceRange? @map("price_range")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  dentists      Dentist[]
  businessHours ClinicBusinessHours[]
  photos        ClinicPhoto[]
  implantBrands ClinicImplantBrand[]
  quotations    Quotation[]
  consultations Consultation[]
  reviews       Review[]

  @@index([latitude, longitude])
  @@index([isPremium])
  @@map("clinics")
}

model ClinicBusinessHours {
  id         String    @id @default(cuid())
  clinicId   String    @map("clinic_id")
  dayOfWeek  DayOfWeek @map("day_of_week")
  openTime   String?   @map("open_time") @db.VarChar(5)
  closeTime  String?   @map("close_time") @db.VarChar(5)
  breakStart String?   @map("break_start") @db.VarChar(5)
  breakEnd   String?   @map("break_end") @db.VarChar(5)
  isClosed   Boolean   @default(false) @map("is_closed")

  clinic Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  @@unique([clinicId, dayOfWeek])
  @@map("clinic_business_hours")
}

model ClinicPhoto {
  id           String @id @default(cuid())
  clinicId     String @map("clinic_id")
  url          String
  displayOrder Int    @default(0) @map("display_order")

  clinic Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  @@map("clinic_photos")
}

// JPA @ElementCollection → 별도 테이블
model ClinicImplantBrand {
  clinicId  String @map("clinic_id")
  brandName String @map("brand_name") @db.VarChar(50)

  clinic Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  @@id([clinicId, brandName])
  @@map("clinic_implant_brands")
}

model QuotationRequest {
  id                    String                 @id @default(cuid())
  patientId             String                 @map("patient_id")
  symptoms              String?                @db.Text
  previousTreatment     String?                @map("previous_treatment") @db.Text
  urgency               Urgency
  minBudget             BigInt?                @map("min_budget")
  maxBudget             BigInt?                @map("max_budget")
  preferredImplantBrand String?                @map("preferred_implant_brand") @db.VarChar(50)
  preferredHospitalType String?                @map("preferred_hospital_type") @db.VarChar(50)
  additionalNotes       String?                @map("additional_notes") @db.Text
  status                QuotationRequestStatus @default(OPEN)
  expiresAt             DateTime?              @map("expires_at")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  patient      Patient                        @relation(fields: [patientId], references: [id])
  quotations   Quotation[]
  missingTeeth QuotationRequestMissingTooth[]
  photos       QuotationRequestPhoto[]

  @@index([status])
  @@index([createdAt])
  @@map("quotation_requests")
}

model QuotationRequestMissingTooth {
  requestId   String @map("quotation_request_id")
  toothNumber String @map("tooth_number")

  request QuotationRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@id([requestId, toothNumber])
  @@map("quotation_request_missing_teeth")
}

model QuotationRequestPhoto {
  id           String @id @default(cuid())
  requestId    String @map("quotation_request_id")
  photoUrl     String @map("photo_url")
  displayOrder Int    @default(0) @map("display_order")

  request QuotationRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@map("quotation_request_photos")
}

model Quotation {
  id                    String          @id @default(cuid())
  quotationRequestId    String          @map("quotation_request_id")
  dentistId             String          @map("dentist_id")
  clinicId              String          @map("clinic_id")
  treatmentPlan         String          @map("treatment_plan") @db.Text
  implantTotalAmount    BigInt          @default(0) @map("implant_total_amount")
  additionalTotalAmount BigInt          @default(0) @map("additional_total_amount")
  totalAmount           BigInt          @map("total_amount")
  discountRate          Int             @default(0) @map("discount_rate")
  discountAmount        BigInt          @default(0) @map("discount_amount")
  finalAmount           BigInt          @map("final_amount")
  treatmentDuration     Int             @map("treatment_duration") // 개월
  warrantyPeriod        Int             @map("warranty_period") // 년
  additionalNotes       String?         @map("additional_notes") @db.Text
  validUntil            DateTime        @map("valid_until") @db.Date
  status                QuotationStatus @default(PENDING)

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  request               QuotationRequest                @relation(fields: [quotationRequestId], references: [id])
  dentist               Dentist                         @relation(fields: [dentistId], references: [id])
  clinic                Clinic                          @relation(fields: [clinicId], references: [id])
  implantItems          QuotationImplantItem[]
  additionalItems       QuotationAdditionalItem[]
  consultationSchedules QuotationConsultationSchedule[]
  statusHistories       QuotationStatusHistory[]
  consultations         Consultation[]
  reviews               Review[]

  @@unique([quotationRequestId, dentistId], name: "uk_request_dentist")
  @@index([quotationRequestId])
  @@index([dentistId])
  @@index([clinicId])
  @@index([status])
  @@index([createdAt])
  @@map("quotations")
}

model QuotationImplantItem {
  id           String @id @default(cuid())
  quotationId  String @map("quotation_id")
  toothNumber  String @map("tooth_number") @db.VarChar(10)
  brand        String @db.VarChar(50)
  quantity     Int    @default(1)
  unitPrice    BigInt @map("unit_price")
  subtotal     BigInt
  displayOrder Int    @default(0) @map("display_order")

  quotation Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)

  @@map("quotation_implant_items")
}

model QuotationAdditionalItem {
  id           String @id @default(cuid())
  quotationId  String @map("quotation_id")
  description  String @db.Text
  price        BigInt
  displayOrder Int    @default(0) @map("display_order")

  quotation Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)

  @@map("quotation_additional_items")
}

model QuotationConsultationSchedule {
  id               String   @id @default(cuid())
  quotationId      String   @map("quotation_id")
  consultationDate DateTime @map("consultation_date") @db.Date
  consultationTime String   @map("consultation_time") @db.VarChar(5)
  duration         Int      @default(60) // 분

  quotation Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)

  @@map("quotation_consultation_schedules")
}

model QuotationStatusHistory {
  id           String           @id @default(cuid())
  quotationId  String           @map("quotation_id")
  oldStatus    QuotationStatus? @map("old_status")
  newStatus    QuotationStatus  @map("new_status")
  changedById  String?          @map("changed_by_id")
  changeReason String?          @map("change_reason") @db.Text

  createdAt DateTime @default(now()) @map("created_at")

  quotation Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  changedBy User?     @relation(fields: [changedById], references: [id])

  @@index([quotationId])
  @@map("quotation_status_histories")
}

model Consultation {
  id          String             @id @default(cuid())
  patientId   String             @map("patient_id")
  dentistId   String             @map("dentist_id")
  clinicId    String             @map("clinic_id")
  quotationId String?            @map("quotation_id")
  scheduledAt DateTime           @map("scheduled_at")
  duration    Int                @default(60)
  status      ConsultationStatus @default(SCHEDULED)
  notes       String?            @db.Text

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  patient   Patient    @relation(fields: [patientId], references: [id])
  dentist   Dentist    @relation(fields: [dentistId], references: [id])
  clinic    Clinic     @relation(fields: [clinicId], references: [id])
  quotation Quotation? @relation(fields: [quotationId], references: [id])

  @@index([patientId])
  @@index([dentistId])
  @@index([scheduledAt])
  @@map("consultations")
}

model Review {
  id          String  @id @default(cuid())
  patientId   String  @map("patient_id")
  dentistId   String  @map("dentist_id")
  clinicId    String  @map("clinic_id")
  quotationId String? @map("quotation_id")
  rating      Int // 1-5
  comment     String? @db.Text

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  patient   Patient    @relation(fields: [patientId], references: [id])
  dentist   Dentist    @relation(fields: [dentistId], references: [id])
  clinic    Clinic     @relation(fields: [clinicId], references: [id])
  quotation Quotation? @relation(fields: [quotationId], references: [id])

  @@index([dentistId])
  @@index([clinicId])
  @@map("reviews")
}

// ──────────────────────────────────────────────────────────
// 채팅 (환자 ↔ 의사 1:1 상담 문의)
// 의료법 27조 회피: 직접 진료 알선/유인 행위 없이 일반 정보 교환 용도.
// 견적 요청 또는 견적서를 컨텍스트로 방이 만들어진다.
// ──────────────────────────────────────────────────────────

model ChatRoom {
  id                 String  @id @default(cuid())
  // 컨텍스트: 견적서 또는 견적 요청 둘 중 하나에 연결 (선택)
  quotationId        String? @map("quotation_id")
  quotationRequestId String? @map("request_id")

  patientId String @map("patient_id")
  dentistId String @map("dentist_id")

  lastMessageAt      DateTime? @map("last_message_at")
  lastMessagePreview String?   @map("last_message_preview") @db.VarChar(100)

  // 마지막 typing ping 시각 (상대 polling 으로 입력 중 표시)
  patientTypingAt DateTime? @map("patient_typing_at")
  dentistTypingAt DateTime? @map("dentist_typing_at")

  // 마지막 미읽음 알림 이메일 발송 시각 (중복 발송 방지)
  lastEmailNotifiedAt DateTime? @map("last_email_notified_at")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  patient  Patient       @relation(fields: [patientId], references: [id])
  dentist  Dentist       @relation(fields: [dentistId], references: [id])
  messages ChatMessage[]

  // 같은 (환자, 의사, 견적서) 조합으로는 방 1개만
  @@unique([quotationId, patientId, dentistId])
  @@index([patientId, lastMessageAt])
  @@index([dentistId, lastMessageAt])
  @@map("chat_rooms")
}

model ChatMessage {
  id         String   @id @default(cuid())
  roomId     String   @map("room_id")
  senderId   String   @map("sender_id")
  senderRole UserRole @map("sender_role")
  content    String   @db.Text
  // 이미지 첨부 (선택)
  imageUrl   String?  @map("image_url")

  // null 이면 미읽음. 상대방이 방에 들어와 GET 할 때 일괄 readAt = now() 처리.
  readAt    DateTime? @map("read_at")
  // 핀 (즐겨찾기) 시각 — null 이면 핀 안됨
  pinnedAt  DateTime? @map("pinned_at")
  // 소프트 삭제 — UI 에서는 "삭제된 메시지입니다" 로 표시
  deletedAt DateTime? @map("deleted_at")

  createdAt DateTime @default(now()) @map("created_at")

  room ChatRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@index([roomId, createdAt])
  @@index([roomId, pinnedAt])
  @@map("chat_messages")
}

// ──────────────────────────────────────────────────────────
// 의사 술식 학습 + 교육 이수 이력
// - Course / CourseLesson: 관리자가 등록하는 의사 전용 술식 강의 (면허 인증 의사만 열람)
// - LessonProgress: 의사별 강의 완료 기록 → 과정의 모든 강의를 마치면 온라인 이수(DentistCredential) 자동 생성
// - DentistCredential: 이수 이력. 온라인 과정은 자동 확인(VERIFIED), 오프라인 연수는 수료증 제출 → 관리자 확인
//   환자 화면에는 VERIFIED 만 "○○ 과정 이수" 로 사실대로 표시한다 ("전문" 표현 금지 — 의료광고)
// ──────────────────────────────────────────────────────────

enum CourseLevel {
  BASIC
  INTERMEDIATE
  ADVANCED
}

enum CredentialSource {
  ONLINE_COURSE
  OFFLINE
  // 교육 사이트(education.denall.com) 수강 이력 연동으로 들어온 이수 — 자동 확인
  EDUCATION_SYNC
}

enum CredentialStatus {
  PENDING
  VERIFIED
  REJECTED
}

model Course {
  id            String      @id @default(cuid())
  title         String      @db.VarChar(200)
  summary       String      @db.Text
  // 연결 술식 — TREATMENT_PLAN_TAGS 의 value (extract, bone_graft, sinus ...)
  procedureTags String[]    @map("procedure_tags")
  level         CourseLevel @default(BASIC)
  instructor    String?     @db.VarChar(100)
  isPublished   Boolean     @default(false) @map("is_published")
  displayOrder  Int         @default(0) @map("display_order")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  lessons     CourseLesson[]
  credentials DentistCredential[]

  @@index([isPublished, displayOrder])
  @@map("courses")
}

model CourseLesson {
  id           String  @id @default(cuid())
  courseId     String  @map("course_id")
  title        String  @db.VarChar(200)
  description  String? @db.Text
  // 영상 주소 — YouTube·Vimeo(임베드) 또는 mp4 주소. 우리 S3 버킷 주소면 서명 URL 로 바꿔 재생
  videoUrl     String? @map("video_url")
  durationMin  Int?    @map("duration_min")
  displayOrder Int     @default(0) @map("display_order")

  course     Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  progresses LessonProgress[]

  @@index([courseId, displayOrder])
  @@map("course_lessons")
}

model LessonProgress {
  dentistId   String   @map("dentist_id")
  lessonId    String   @map("lesson_id")
  completedAt DateTime @default(now()) @map("completed_at")

  dentist Dentist      @relation(fields: [dentistId], references: [id], onDelete: Cascade)
  lesson  CourseLesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@id([dentistId, lessonId])
  @@map("lesson_progresses")
}

model DentistCredential {
  id             String           @id @default(cuid())
  dentistId      String           @map("dentist_id")
  // 온라인 과정 이수일 때만 채워짐 (과정당 1건)
  courseId       String?          @map("course_id")
  // 오스템 교육 프로그램 키 (src/lib/content/education-programs.ts)
  programKey     String?          @map("program_key") @db.VarChar(50)
  // 교육 사이트 연동 건의 원본 수강 ID — 같은 이력을 두 번 넣지 않게 한다
  externalId     String?          @unique @map("external_id") @db.VarChar(100)
  title          String           @db.VarChar(200)
  issuer         String           @db.VarChar(100)
  completedOn    DateTime         @map("completed_on") @db.Date
  source         CredentialSource
  status         CredentialStatus @default(PENDING)
  // 오프라인 수료증 사진 (S3 — 화면에는 서명 URL)
  certificateUrl String?          @map("certificate_url")
  reviewedById   String?          @map("reviewed_by_id")
  reviewedAt     DateTime?        @map("reviewed_at")
  rejectReason   String?          @map("reject_reason") @db.Text

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  dentist Dentist @relation(fields: [dentistId], references: [id], onDelete: Cascade)
  course  Course? @relation(fields: [courseId], references: [id])

  @@unique([dentistId, courseId])
  @@index([dentistId, status])
  @@index([status, createdAt])
  @@map("dentist_credentials")
}

// ──────────────────────────────────────────────────────────
// 의사 월 정액 이용권 (9,900원/월, 토스페이먼츠 카드 자동결제)
// - 금액은 서버 상수(src/lib/subscription.ts)로만 정한다
// - billingKey 는 암호화해서 저장한다 (BILLING_KEY_SECRET)
// - 관리자가 결제 없이 기간을 줄 수도 있다 (source = ADMIN_GRANT)
// - 구독 필수 여부는 환경변수 SUBSCRIPTION_ENFORCED 로 켠다 (법무 확인 후)
// ──────────────────────────────────────────────────────────

enum SubscriptionStatus {
  PENDING // 카드 등록 전
  ACTIVE
  PAST_DUE // 갱신 결제 실패 — 며칠 재시도
  CANCELED // 해지 (기간 끝까지 쓰고 종료)
  EXPIRED // 재시도 끝 또는 무료 기간 종료
}

enum SubscriptionSource {
  TOSS_BILLING
  ADMIN_GRANT
}

enum SubscriptionPaymentStatus {
  PENDING
  DONE
  FAILED
}

model DentistSubscription {
  id                 String             @id @default(cuid())
  dentistId          String             @unique @map("dentist_id")
  plan               String             @default("MONTHLY") @db.VarChar(30)
  amount             Int
  status             SubscriptionStatus @default(PENDING)
  source             SubscriptionSource @default(TOSS_BILLING)
  // 토스 고객 키 (추측하기 어려운 무작위 값)
  customerKey        String             @unique @map("customer_key") @db.VarChar(64)
  billingKeyEnc      String?            @map("billing_key_enc") @db.Text
  cardSummary        String?            @map("card_summary") @db.VarChar(100)
  currentPeriodStart DateTime?          @map("current_period_start")
  currentPeriodEnd   DateTime?          @map("current_period_end")
  cancelAtPeriodEnd  Boolean            @default(false) @map("cancel_at_period_end")
  canceledAt         DateTime?          @map("canceled_at")
  failedCount        Int                @default(0) @map("failed_count")
  lastFailure        String?            @map("last_failure") @db.Text

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  dentist  Dentist               @relation(fields: [dentistId], references: [id], onDelete: Cascade)
  payments SubscriptionPayment[]

  @@index([status, currentPeriodEnd])
  @@map("dentist_subscriptions")
}

model SubscriptionPayment {
  id             String                    @id @default(cuid())
  subscriptionId String                    @map("subscription_id")
  // 기간마다 하나 — 같은 기간을 두 번 결제하지 않게 토스에도 같은 값을 보낸다
  orderId        String                    @unique @map("order_id") @db.VarChar(64)
  paymentKey     String?                   @unique @map("payment_key") @db.VarChar(200)
  amount         Int
  status         SubscriptionPaymentStatus @default(PENDING)
  periodStart    DateTime                  @map("period_start")
  periodEnd      DateTime                  @map("period_end")
  approvedAt     DateTime?                 @map("approved_at")
  receiptUrl     String?                   @map("receipt_url")
  failureCode    String?                   @map("failure_code") @db.VarChar(100)
  failureMessage String?                   @map("failure_message") @db.Text

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  subscription DentistSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([subscriptionId, createdAt])
  @@map("subscription_payments")
}
