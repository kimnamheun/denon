# ============================================================
# Next.js
# ============================================================
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ============================================================
# Auth.js (NextAuth v5)
# 생성 명령: openssl rand -base64 32
# ============================================================
AUTH_SECRET=replace_with_generated_secret
AUTH_TRUST_HOST=true

# ============================================================
# PostgreSQL
# prisma/schema.prisma 의 datasource 는 DATABASE_URL 하나만 읽는다.
# Vercel 에서 Postgres 를 연결했다면 그 연결 URL 을 DATABASE_URL 로 등록한다.
# ============================================================
DATABASE_URL=postgres://user:password@host/db?sslmode=require

# ============================================================
# Vercel Cron 인증 (필수)
# Vercel 은 이 값이 있으면 cron 호출에 `Authorization: Bearer <CRON_SECRET>` 를 붙인다.
# 비어 있으면 /api/cron/* 은 모두 401 로 거절된다.
# 생성 명령: openssl rand -base64 32
# ============================================================
CRON_SECRET=replace_with_generated_secret

# ============================================================
# 시드 관리자 비밀번호 (선택)
# 비우면 npm run db:seed 가 무작위 비밀번호를 만들어 콘솔에 한 번 보여준다.
# ============================================================
# SEED_ADMIN_PASSWORD=

# ============================================================
# AWS S3 (사진 업로드)
# 구강 사진은 건강정보라 버킷은 비공개(Block Public Access)로 둔다.
# 화면에는 서버가 만든 서명 URL(최대 2시간 유효)로만 보인다.
# ============================================================
AWS_REGION=ap-northeast-2
AWS_S3_BUCKET=dental-platform-bucket
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ============================================================
# Naver Maps API
# Vercel 환경변수에 등록 시 NEXT_PUBLIC_ 접두사로 클라이언트 노출 가능
# ============================================================
NEXT_PUBLIC_NAVER_MAP_CLIENT_ID=
NAVER_MAP_CLIENT_SECRET=

# ============================================================
# (선택) Upstash Redis - 캐싱/세션
# ============================================================
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# ============================================================
# (선택) 이메일 SMTP (Gmail)
# ============================================================
# EMAIL_SERVER_HOST=smtp.gmail.com
# EMAIL_SERVER_PORT=587
# EMAIL_SERVER_USER=
# EMAIL_SERVER_PASSWORD=
# EMAIL_FROM=noreply@dental-platform.com
